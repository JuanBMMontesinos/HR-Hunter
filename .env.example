# ==============================================================================
# HR Hunter — Environment Variables Template
# Copy this file to .env (and/or backend/.env, frontend/.env) and fill real values.
# NEVER commit .env files with real passwords or secrets to Git.
# ==============================================================================

# Server
NODE_ENV=development
PORT=3000
TZ=America/Sao_Paulo
LOG_LEVEL=info

# Supabase PostgreSQL Direct Connection (IPv6 / Session Pooler IPv4)
# For Docker/CI environments without IPv6 routing, use Supabase Session Pooler (IPv4)
# Project Ref: fhhgtjzwmhgdiokqqebg
DATABASE_URL='postgresql://postgres:[DB_PASSWORD]@db.fhhgtjzwmhgdiokqqebg.supabase.co:5432/postgres'
DB_SSL=true

# Optional Supabase API (if using Storage/Client SDK)
SUPABASE_URL=https://fhhgtjzwmhgdiokqqebg.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Authentication & Security
JWT_SECRET=replace_with_64_char_random_secret
JWT_REFRESH_SECRET=replace_with_another_64_char_random_secret
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
ENABLE_RETENTION_CRON=false

# Frontend & CORS
FRONTEND_URL=http://localhost:5173,http://localhost:8081
FRONTEND_PORT=8081
API_URL=http://localhost:3000
VITE_API_BASE_URL=/api/v1
# Set COOKIE_SECURE=false only for local HTTP Docker Compose testing (always true on HTTPS production)
COOKIE_SECURE=false

# SMTP Email Settings
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hrhunter.com

# Playwright Test Runner
PLAYWRIGHT_BASE_URL=http://localhost:5173
PLAYWRIGHT_API_URL=http://localhost:3000/api/v1
